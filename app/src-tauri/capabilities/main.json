{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call only this app's own commands and open the native file and folder pickers. No shell, file system, HTTP, or opener access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-list-drives",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-get-node",
    "allow-list-children",
    "allow-treemap",
    "allow-open-in-explorer",
    "allow-relaunch-elevated",
    "allow-start-junk-scan",
    "allow-cancel-junk-scan",
    "allow-junk-items",
    "allow-clean-preview",
    "allow-clean-manual",
    "allow-clean-execute",
    "allow-cancel-clean",
    "allow-deep-clean",
    "allow-recovery-overview",
    "allow-recovery-batch",
    "allow-recovery-conflicts",
    "allow-recovery-restore",
    "allow-recovery-delete",
    "allow-recovery-empty",
    "allow-get-settings",
    "allow-save-settings",
    "allow-exclude-node",
    "allow-open-rules-folder",
    "dialog:allow-open"
  ]
}
