{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call only this app's own commands and open the native folder picker. No shell, file system, HTTP, or opener access.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-list-drives",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-get-node",
    "allow-list-children",
    "allow-treemap",
    "allow-open-in-explorer",
    "allow-relaunch-elevated",
    "dialog:allow-open"
  ]
}
